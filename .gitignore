# Root-level ignore for the face-liveness platform.
# The enclosing `Thirduni` repo also has its own .gitattributes (LFS for *.mp4).

# --- Node ---
node_modules/
dist/
build/
.vite/
*.tsbuildinfo
.npm/
.eslintcache

# Packed tarballs (never commit built packages)
*.tgz

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# --- Model weights ---
# The two checkpoints required at runtime ARE committed to this repo, at
# services/face-liveness-api/models/, so the deploy needs no download step.
# They are un-ignored explicitly below. Every other weight file — including
# the research project's saved_models/ and the alternate .pth extractor —
# stays out of git.
saved_models/
*.pt
*.pth
*.ckpt
!services/face-liveness-api/models/EfficientNet_B2.pt
!services/face-liveness-api/models/ABC_BiLSTM_Undercomplete_AE.pt

# --- Secrets / local config ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials.json

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
